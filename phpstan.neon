parameters:
    inferPrivatePropertyTypeFromConstructor: true
    level: 9
    paths:
        - src
    # Defines the one constant OpenSwoole's own signatures need and PHP 8.4 no
    # longer has. See the file: without it the analysis aborts entirely, rather
    # than reporting an error, on any file that names OpenSwoole\Process.
    bootstrapFiles:
        - phpstan-bootstrap.php

includes:
    # Baseline holding **only** findings inside flatc-generated tables. Those
    # files are rewritten on every `composer flatbuffers`, so an error there
    # cannot be fixed in place — the fix belongs in scripts/patch-flatbuffers.php,
    # which already normalizes builder casing, create*() return docblocks,
    # child-table sentinels, scalar type names and string accessor types.
    #
    # src/API/Fbs/ now holds *nothing but* generated tables, so this baseline and
    # that directory are the same set: everything hand-written, including the DTOs
    # and abstract factories in src/API/Negociation/, stays fully analysed at
    # level 9. Regenerate with scripts/generate-phpstan-baseline.php after
    # changing the schemas.
    - phpstan-generated-baseline.neon
