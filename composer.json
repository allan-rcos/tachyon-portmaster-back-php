{
  "name": "tachyon/portmaster",
  "description": "Base de ecossistema minimalista para criação de apis",
  "type": "boilerplate",
  "version": "1.1.0",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "PortMaster\\": "src/",
      "Tests\\": "tests/",
      "App\\": "src/App/",
      "API\\": "src/API/",
      "Infra\\": "src/Infra/",
      "Domain\\": "src/Domain/",
      "Shared\\": "src/Shared/"
    }
  },
  "authors": [
    {
      "name": "allan-rcos",
      "email": "ricardoallancosta@hotmail.com"
    }
  ],
  "require-dev": {
    "openswoole/ide-helper": "^26.2",
    "php-ds/php-ds": "^2.0",
    "phpstan/phpstan": "^2.2",
    "pestphp/pest": "^4.7",
    "mockery/mockery": "^1.6"
  },
  "require": {
    "nikic/fast-route": "^1.3",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.10",
    "atlas/query": "^2.0",
    "firebase/php-jwt": "^7.1",
    "ext-ds": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*",
    "ext-iconv": "*",
    "google/flatbuffers": "^25.12",
    "openswoole/core": "^26.2",
    "symfony/uid": "^8.1",
    "hidehalo/nanoid-php": "^2.0"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  }
}
