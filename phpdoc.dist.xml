<?xml version="1.0" encoding="UTF-8" ?>
<phpdocumentor configVersion="3.0">
    <paths>
        <output>docs/phpdocumentor</output>
        <cache>build/docs-cache</cache>
    </paths>
    <version number="0.0.1">
        <folder>latest</folder>
        <api format="php">
            <!--
                Only src/ is rendered. The bootstrap entry point (src/API/main.php)
                is procedural rather than a class, and the Go integration suite
                documents itself through `go doc`, so neither belongs here.
            -->
            <source dsn=".">
                <path>src</path>
            </source>
            <output>api</output>

            <ignore hidden="true" symlinks="true">
                <path>vendor/**/*</path>
                <path>tests/**/*</path>
                <path>var/**/*</path>
                <path>build/**/*</path>
                <path>db/**/*</path>
                <path>docs/**/*</path>
                <path>scripts/**/*</path>
                <path>swagger/**/*</path>

                <!--
                    flatc-generated tables and enums.

                    Every `composer flatbuffers` run overwrites these, so any
                    docblock written into them is lost on the next schema change
                    — which is exactly why they are excluded rather than
                    documented. What the rest of the codebase actually talks to
                    is the hand-written `*Proxy` class layered over each one
                    (see src/API/Fbs/Contracts/IFbsProxy.php), and those ARE
                    documented and rendered.

                    The same boundary is drawn in phpstan.neon, whose baseline
                    holds findings from these files and nothing else.

                    Regenerate this list after adding or removing a schema:

                        grep -rl 'automatically generated by the FlatBuffers compiler' src | sort
                -->
                <path>src/API/Fbs/Account/AccountPasswordChangeRequest.php</path>
                <path>src/API/Fbs/Account/AccountProfileResponse.php</path>
                <path>src/API/Fbs/Account/AccountUpdateRequest.php</path>
                <path>src/API/Fbs/Account/RoleResponse.php</path>
                <path>src/API/Fbs/Admin/RoleCreateRequest.php</path>
                <path>src/API/Fbs/Admin/RoleListResponse.php</path>
                <path>src/API/Fbs/Admin/RolePermissionsUpdateRequest.php</path>
                <path>src/API/Fbs/Admin/UserAdminPasswordResetRequest.php</path>
                <path>src/API/Fbs/Admin/UserAdminResponse.php</path>
                <path>src/API/Fbs/Admin/UserCreateRequest.php</path>
                <path>src/API/Fbs/Admin/UserListResponse.php</path>
                <path>src/API/Fbs/Admin/UserUpdateRequest.php</path>
                <path>src/API/Fbs/Auth/LoginRequest.php</path>
                <path>src/API/Fbs/Auth/LoginResponse.php</path>
                <path>src/API/Fbs/Auth/SetupRequest.php</path>
                <path>src/API/Fbs/Auth/User.php</path>
                <path>src/API/Fbs/Common/ContainerStatus.php</path>
                <path>src/API/Fbs/Common/ProblemDetails.php</path>
                <path>src/API/Fbs/Common/RiskClass.php</path>
                <path>src/API/Fbs/Common/TelemetryEvent.php</path>
                <path>src/API/Fbs/Container/CargoManifestItem.php</path>
                <path>src/API/Fbs/Container/ContainerCreateRequest.php</path>
                <path>src/API/Fbs/Container/ContainerListResponse.php</path>
                <path>src/API/Fbs/Container/ContainerResponse.php</path>
                <path>src/API/Fbs/Container/ContainerSummaryListResponse.php</path>
                <path>src/API/Fbs/Container/ContainerSummaryResponse.php</path>
                <path>src/API/Fbs/Container/ContainerUpdateRequest.php</path>
                <path>src/API/Fbs/Container/TelemetryLogItem.php</path>
                <path>src/API/Fbs/Manifest/LoadItemRequest.php</path>
                <path>src/API/Fbs/Manifest/ManifestResponse.php</path>
                <path>src/API/Fbs/Manifest/UnloadItemRequest.php</path>
                <path>src/API/Fbs/Metadata/MetadataItemResponse.php</path>
                <path>src/API/Fbs/Metadata/PermissionListResponse.php</path>
                <path>src/API/Fbs/Metrics/MetricsResponse.php</path>
                <path>src/API/Fbs/Metrics/OccupancyDivision.php</path>
                <path>src/API/Fbs/Product/ProductCreateRequest.php</path>
                <path>src/API/Fbs/Product/ProductListResponse.php</path>
                <path>src/API/Fbs/Product/ProductResponse.php</path>
                <path>src/API/Fbs/Product/ProductUpdateRequest.php</path>
                <path>src/API/Fbs/Server/ProjectInfo.php</path>
                <path>src/API/Fbs/Token/TokenRole.php</path>
                <path>src/API/Fbs/Token/TokenUser.php</path>
            </ignore>

            <default-package-name>Portmaster</default-package-name>
            <include-source>true</include-source>
            <markers>
                <marker>TODO</marker>
                <marker>FIXME</marker>
            </markers>
        </api>
    </version>
    <setting name="template.color" value="indigo"/>
</phpdocumentor>
